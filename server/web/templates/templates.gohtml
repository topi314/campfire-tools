{{ define "export_included_fields" }}
    <label class="form-control" for="included-fields" title="Select which fields to include in the export.">
        Included Fields
        <select class="form-control" id="included-fields" name="included_fields" size="10" required multiple>
            <option value="user_id" selected>User ID</option>
            <option value="username" selected>Username</option>
            <option value="display_name" selected>Display Name</option>
            <option value="rsvp_status" selected>RSVP Status</option>
            <option value="event_id" selected>Event ID</option>
            <option value="event_name" selected>Event Name</option>
            <option value="event_url">Event URL</option>
            <option value="event_time">Event Time</option>
            <option value="event_club_id">Event Club ID</option>
            <option value="event_creator_id">Event Creator ID</option>
            <option value="event_creator_username">Event Creator Username</option>
            <option value="event_discord_interested">Event Discord Interested</option>
            <option value="event_created_by_community_ambassador">Event Created by Community Ambassador</option>
            <option value="event_campfire_live_event_id">Event Campfire Live Event ID</option>
            <option value="event_campfire_live_event_name">Event Campfire Live Event Name</option>
        </select>
    </label>
{{ end }}

{{ define "league_progress" }}
    <span class="{{ if eq . 100.0 }}green{{ else if gt . 66.0 }}yellow{{ else if gt . 33.0 }}orange{{ else }}red{{ end }}">
        {{ . }}%
    </span>
{{ end }}

{{ define "checkbox" }}
    {{ if . }}✅️{{ else }}❌{{ end }}
{{ end}}

{{ define "event_cover" }}
    {{ if .CoverPhotoURL }}
        <img src="{{ .CoverPhotoURL }}" alt="">
    {{ else if .ClubAvatarURL }}
        <img src="{{ .ClubAvatarURL }}" alt="">
    {{ else }}
        <img src="/static/default.png" alt="">
    {{ end }}
{{ end }}

{{ define "event_list_item" }}
    <li class="list-item">
        <a class="list-item-link" href="{{ .URL }}" title="{{ .ID }}" hx-boost="true">
            {{ template "event_cover" . }}
            <div class="list-item-content">
                <div class="list-item-title">
                    <span class="list-item-name">{{ .Name }}</span>{{ template "community_ambassador_flag" .CreatedByCommunityAmbassador }}
                </div>
                <span class="small-text">
                    {{ localTime .Time "date" }}{{ if .Category }} · {{ formatEventCategory .Category }}{{ end }}
                </span>
            </div>
        </a>
    </li>
{{ end }}

{{ define "event_club_group" }}
    <details class="event-club-group" open>
        <summary class="event-club-group-header">
            <h3>
                {{ if .Club.AvatarURL }}
                    <img src="{{ .Club.AvatarURL }}" class="icon-32" alt="">
                {{ else }}
                    <img src="/static/default.png" class="icon-32" alt="">
                {{ end }}
                <a href="{{ .Club.URL }}" hx-boost="true" onclick="event.stopPropagation()">{{ .Club.Name }}</a>
                {{ template "community_ambassador_flag" .Club.CreatedByCommunityAmbassador }}
                <span class="event-club-group-count">({{ len .Events }})</span>
            </h3>
        </summary>
        <ul class="list">
            {{ range $event := .Events }}
                {{ template "event_list_item" $event }}
            {{ end }}
        </ul>
    </details>
{{ end }}

{{ define "community_ambassador_icon" }}
    <img src="/static/community-ambassador.png" class="icon-32 ca-icon" alt="Community Ambassador" title="Community Ambassador">
{{ end }}

{{ define "community_ambassador_flag" }}
    {{ if . }}{{ template "community_ambassador_icon" }}{{ end }}
{{ end }}

{{ define "campfire_member_name" }}
    <a href="{{ .URL }}" title="{{ .Username }}" hx-boost="true">{{ .DisplayName }}</a>{{ template "community_ambassador_flag" .IsCommunityAmbassador }}
{{ end }}

{{ define "campfire_member_name_plain" }}
    <span title="{{ .Username }}">{{ .DisplayName }}</span>{{ template "community_ambassador_flag" .IsCommunityAmbassador }}
{{ end }}

{{ define "campfire_member_inline" }}
    {{ if .AvatarURL }}
        <img class="icon-32" src="{{ .AvatarURL }}" alt="">
    {{ else }}
        <img class="icon-32" src="/static/default_avatar.png" alt="">
    {{ end }}
    {{ template "campfire_member_name" . }}
{{ end }}

{{ define "campfire_member_list_item" }}
    <li class="list-item">
        <a class="list-item-link" href="{{ .URL }}" title="{{ .Username }}" hx-boost="true">
            {{ if .AvatarURL }}
                <img src="{{ .AvatarURL }}" alt="">
            {{ else }}
                <img src="/static/default_avatar.png" alt="">
            {{ end }}
            <div class="list-item-content">
                <div class="list-item-title">
                    <span class="list-item-name">{{ .DisplayName }}</span>{{ template "community_ambassador_flag" .IsCommunityAmbassador }}
                </div>
                {{ if .Username }}
                    <span class="small-text">@{{ .Username }}</span>
                {{ end }}
            </div>
        </a>
    </li>
{{ end }}

{{ define "campfire_member_header" }}
    {{ if .AvatarURL }}
        <img src="{{ .AvatarURL }}" alt="">
    {{ else }}
        <img src="/static/default_avatar.png" alt="">
    {{ end }}
    {{ template "campfire_member_name_plain" . }}
{{ end }}

{{ define "events_filter" }}
    <form id="events-filter" class="events-filter" hx-get="{{ .FilterURL }}" hx-params="not quarter" hx-push-url="true" hx-target="body">
        <div class="events-filter-fields">
            <div id="events-filter-range" class="events-filter-dates">
                <label for="from">
                    From
                    <input type="date" id="from" name="from" hx-on:change="fromChangeHandler()" {{ if not .From.IsZero }}value="{{ formatDate .From }}"{{ end }}>
                </label>
                <label for="to">
                    To
                    <input type="date" id="to" name="to" hx-on:change="toChangeHandler()" {{ if not .To.IsZero }}value="{{ formatDate .To }}"{{ end }}>
                </label>
            </div>

            <label class="events-filter-quarter" for="date-preset">
                <select id="date-preset" name="quarter" hx-get="/tracker/quarter-filters" hx-target="#events-filter-range" hx-swap="outerHTML" hx-select="#events-filter-range" hx-params="*"
                        hx-push-url="false">
                    <option value="">Select Quarter</option>
                    {{ range $quarter := .Quarters }}
                        <option value="{{ $quarter.Value }}">
                            {{ $quarter.Name }}
                        </option>
                    {{ end }}
                </select>
            </label>

            <label class="events-filter-ca" for="only-ca-events">
                <input type="checkbox" id="only-ca-events" name="only-ca-events" {{ if .OnlyCAEvents }}checked{{ end }}>
                Only CA Events
            </label>

            <label class="events-filter-creator" for="event-creator">
                <select id="event-creator" name="event-creator">
                    <option value="">All Event Creators</option>
                    {{ range $creator := .EventCreators }}
                        <option value="{{ $creator.ID }}" {{ if eq $.SelectedEventCreator $creator.ID }}selected{{ end }}>
                            {{ $creator.Username }}
                        </option>
                    {{ end }}
                </select>
            </label>

            <label class="events-filter-category" for="event-category">
                <select id="event-category" name="event-category">
                    <option value="">All Event Categories</option>
                    {{ range $category := .CategoryOptions }}
                        <option value="{{ $category }}" {{ if eq $.SelectedEventCategory $category }}selected{{ end }}>
                            {{ formatEventCategory $category }}
                        </option>
                    {{ end }}
                </select>
            </label>

            <button type="submit" class="events-filter-submit">Filter</button>
        </div>
    </form>
    <script>
        fromChangeHandler();
        toChangeHandler();

        function fromChangeHandler() {
            const fromDate = document.getElementById("from");
            const toDate = document.getElementById("to");
            if (!fromDate || !toDate) {
                return;
            }

            if (fromDate.value && toDate.value && fromDate.value > toDate.value) {
                toDate.value = fromDate.value;
            }
            toDate.min = fromDate.value;
        }

        function toChangeHandler() {
            const fromDate = document.getElementById("from");
            const toDate = document.getElementById("to");
            if (!fromDate || !toDate) {
                return;
            }

            if (fromDate.value && toDate.value && toDate.value < fromDate.value) {
                fromDate.value = toDate.value;
            }
            fromDate.max = toDate.value;
        }
    </script>
{{ end }}

{{ define "back_button" }}
    <a href="{{ . }}" class="back" hx-boost="true" aria-label="Back">
        <img src="/static/back.svg" alt="Back">
    </a>
{{ end }}

{{ define "club_nav" }}
    <nav class="club-nav" aria-label="Club" hx-boost="true">
        <a href="{{ .URL }}" {{ if eq .Active "club" }}aria-current="page"{{ end }}>Overview</a>
        <a href="{{ .URL }}/stats" {{ if eq .Active "stats" }}aria-current="page"{{ end }}>Statistics</a>
        <a href="{{ .URL }}/events" {{ if eq .Active "events" }}aria-current="page"{{ end }}>Events</a>
        <a href="{{ .URL }}/members" {{ if eq .Active "members" }}aria-current="page"{{ end }}>Members</a>
        <a href="{{ .URL }}/raffle" {{ if eq .Active "raffle" }}aria-current="page"{{ end }}>Raffle</a>
        <a href="{{ .URL }}/checklist" {{ if eq .Active "checklist" }}aria-current="page"{{ end }}>Checklist</a>
        <a href="{{ .URL }}/export" {{ if eq .Active "export" }}aria-current="page"{{ end }}>Export</a>
    </nav>
{{ end }}

{{ define "discord_user" }}
    <span title="{{ .ID }}"><img src="{{ .AvatarURL }}" class="icon-18" alt=""> {{ .EffectiveName }}</span>
{{ end }}
{{ template "head" "Reward Edit" }}
<div class="container container-wide">
    <div class="container-header">
        {{ template "back_button" .BackURL }}
        <div>
            <h1>Edit reward</h1>
            <p class="small-text">{{ .RedeemedCodes }} of {{ .TotalCodes }} codes redeemed{{ if .Archived }} · Archived{{ end }}</p>
        </div>
    </div>

    <div class="section">
        <form hx-patch="{{ .URL }}" hx-encoding="multipart/form-data" hx-target="body" hx-push-url="true">
            <label for="name">Name
                <input type="text" id="name" name="name" required value="{{ .Name }}">
            </label>

            <label for="description">Description
                <textarea id="description" name="description" rows="4">{{ .Description }}</textarea>
            </label>

            <label for="codes">Add codes
                <textarea id="codes" name="codes" class="codes-input" rows="5" placeholder="One code per line"></textarea>
            </label>
            <p class="small-text">Leave this empty to keep the current codes. Separate new codes with a new line, comma, or space.</p>

            {{ if .Error }}
                <p class="error">{{ .Error }}</p>
            {{ end }}

            <div class="form-actions">
                <button type="submit">Save</button>
            </div>
        </form>

        <div class="form-danger">
            <p>{{ if .Archived }}This reward is archived. Restoring it puts it back on the active list.{{ else }}Archiving hides this reward from the active list. Existing codes stay redeemable.{{ end }}</p>
            <div class="buttons">
                {{ if .Archived }}
                    <button type="button" hx-post="{{ .URL }}/unarchive" hx-confirm="Restore this reward to the active list?">Unarchive</button>
                {{ else }}
                    <button type="button" hx-post="{{ .URL }}/archive">Archive</button>
                {{ end }}
                <button type="button" hx-delete="{{ .URL }}" class="danger" hx-confirm="Are you sure you want to delete this reward? This action cannot be undone.">Delete</button>
            </div>
        </div>
    </div>

</div>
{{ template "tracker_footer" }}

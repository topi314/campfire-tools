{{ template "head" "Campfire Event Tracker" }}
<div class="container container-wide">
    <div class="container-header">
        {{ template "back_button" "/tracker" }}
        <h1>Tracker</h1>
    </div>

    <div class="buttons" hx-boost="true">
        <a class="button" href="/tracker/club/import">Import Club</a>
        <a class="button" href="/tracker/event/import">Import Events</a>
    </div>

    <div id="clubs" class="section">
        <div class="section-header">
            <h2>Clubs ({{ len .Clubs }})</h2>
            <div class="inline-form-control">
                <label for="sort">
                    <select id="sort" name="sort" hx-get="/tracker/clubs" hx-target="#clubs" hx-swap="outerHTML" hx-select="#clubs" hx-push-url="true">
                        <option value="name" {{ if eq .Sort "name" }}selected{{ end }}>Name</option>
                        <option value="events" {{ if eq .Sort "events" }}selected{{ end }}>Events</option>
                    </select>
                </label>
            </div>
        </div>
        <ul class="list">
            {{ range $club := .Clubs }}
                <li class="list-item">
                    <a class="list-item-link" href="{{ $club.URL }}" hx-boost="true">
                        {{ if $club.AvatarURL }}
                            <img src="{{ $club.AvatarURL }}" alt="">
                        {{ else }}
                            <img src="/static/default.png" alt="">
                        {{ end }}
                        <div class="list-item-content">
                            <div class="list-item-title">
                                {{ if $club.Pinned }}<span class="club-pin" title="Pinned" aria-label="Pinned">📌</span>{{ end }}
                                <span class="list-item-name">{{ $club.Name }}</span>{{ template "community_ambassador_flag" $club.CreatedByCommunityAmbassador }}
                            </div>
                            <span class="small-text">{{ $club.Events }} events</span>
                        </div>
                    </a>
                </li>
            {{ else }}
                <li class="empty">No clubs tracked yet.</li>
            {{ end }}
        </ul>
    </div>
</div>
{{ template "tracker_footer" }}

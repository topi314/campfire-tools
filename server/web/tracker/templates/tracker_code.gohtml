{{ template "head" "Code Request" }}
<div class="container container-wide">
    <div class="container-header">
        <h1>Code Request</h1>
    </div>

    <div class="section">
        <form hx-post="/tracker/code/{{ .Code }}">
            <button type="submit">Grant Code</button>
        </form>
    </div>

</div>
{{ template "tracker_footer" }}

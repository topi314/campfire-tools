{{ template "head" "Campfire Raffle Result" }}
<div class="container">
    <div class="container-header">
        {{ template "back_button" .BackURL }}
        <h1>{{ if .Title }}{{ .Title }}{{ else if .ID }}#{{ .ID }}{{ else }}Raffle Result{{ end }}</h1>
        {{ if .ID }}
            <div class="buttons header-actions">
                <form id="raffle-rerun-form" action="{{ .RerunRaffleURL }}" method="POST">
                    <input type="hidden" name="past_winners" value="{{ if $.PastWinnersOpen }}true{{ else }}false{{ end }}">
                    <input type="hidden" name="blocked_members" value="{{ if $.BlockedMembersOpen }}true{{ else }}false{{ end }}">
                    <input type="hidden" name="confirmed" value="{{ if $.ConfirmedOpen }}true{{ else }}false{{ end }}">
                    <button type="submit" class="button rerun">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                            <path d="M21 3v5h-5"></path>
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                            <path d="M8 16H3v5"></path>
                        </svg>
                        Rerun
                    </button>
                </form>
                <button type="button" class="button" data-copy="{{ .ShareURL }}" title="Copy share link" aria-label="Copy share link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                </button>
                <a href="{{ .AddEventsURL }}" class="button" title="Edit" aria-label="Edit" hx-boost="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                </a>
            </div>
        {{ end }}
    </div>

    {{ if .Error }}
        <div class="error">
            <p>{{ .Error }}</p>
        </div>
    {{ end }}

    <div id="raffle-notice">
        {{ template "raffle_notice_body" . }}
    </div>

    {{ template "raffle_live" . }}

    <div class="section details">
        <h2>Details</h2>
        <dl>
            <div>
                <dt>Created</dt>
                <dd>{{ localTime .CreatedAt "relative" }}</dd>
            </div>
            <div>
                <dt>Winners</dt>
                <dd>{{ .WinnerCount }}</dd>
            </div>
            <div>
                <dt>Checked-in only</dt>
                <dd>{{ if .OnlyCheckedIn }}Yes{{ else }}Checked-in and accepted{{ end }}</dd>
            </div>
            <div>
                <dt>Single entry</dt>
                <dd>{{ if .SingleEntry }}Yes{{ else }}No{{ end }}</dd>
            </div>
            {{ if .Users }}
                <div class="details-wide">
                    <dt>Sharing</dt>
                    <dd>
                        <ul>
                            {{ range $user := .Users }}
                                <li>{{ template "discord_user" $user }}</li>
                            {{ end }}
                        </ul>
                    </dd>
                </div>
            {{ end }}
            <div class="details-wide">
                <dt>Events</dt>
                <dd>
                    {{ if .Events }}
                        <ul>
                            {{ range $event := .Events }}
                                <li><a href="/event/{{ $event.ID }}" hx-boost="true">{{ $event.Name }}</a></li>
                            {{ end }}
                        </ul>
                    {{ else }}
                        None
                    {{ end }}
                </dd>
            </div>
        </dl>
    </div>
</div>
<script>
    if (!window.__raffleToggleBound) {
        window.__raffleToggleBound = true;
        document.addEventListener("toggle", (event) => {
            if (event.target.id === "past-winners" || event.target.id === "blocked-members" || event.target.id === "confirmed") {
                toggleParam(event.target, event.target.id);
            }
        }, true);
        document.addEventListener("htmx:afterSwap", (event) => {
            const target = event.target;
            if (!target || target.id !== "raffle-live") {
                return;
            }
            ["past-winners", "blocked-members", "confirmed"].forEach((id) => {
                const element = document.getElementById(id);
                const open = !!(element && element.open);
                document.querySelectorAll(`input[name="${id.replaceAll("-", "_")}"]`).forEach((field) => {
                    field.value = open ? "true" : "false";
                });
            });
        });
    }

    function toggleParam(element, name) {
        const url = new URL(window.location);
        if (element.open) {
            url.searchParams.set(name, "true");
        } else {
            url.searchParams.delete(name);
        }
        document.querySelectorAll(`input[name="${name.replaceAll("-", "_")}"]`).forEach(field => {
            field.value = element.open ? "true" : "false";
        })

        window.history.replaceState(null, "", url.toString());
    }
</script>
{{ template "tracker_footer" }}

{{ define "raffle_winner" }}
    <li title="{{ .Winner.Username }}">
        <div>
            <span class="checklist-person">
                {{ if .Winner.AvatarURL }}
                    <img src="{{ .Winner.AvatarURL }}" class="icon-32" alt="">
                {{ else }}
                    <img src="/static/default_avatar.png" class="icon-32" alt="">
                {{ end }}
                <span class="checklist-person-name">
                    <span>{{ .Winner.DisplayName }}{{ if .Winner.CheckIns }} ({{ .Winner.CheckIns }}){{ end }}</span>
                    {{ if .Winner.Username }}
                        <span class="small-text">{{ .Winner.Username }}</span>
                    {{ end }}
                </span>
            </span>
            {{ if or .CanBlock (not .Winner.Previous) .Winner.Confirmed }}
                <span class="checklist-actions">
                    {{ if and .CanBlock (not (index .BlockedMemberID .Winner.ID)) }}
                        <form action="{{ .BlockAction }}{{ .Winner.ID }}" method="POST" hx-post="{{ .BlockAction }}{{ .Winner.ID }}" hx-target="#raffle-live" hx-swap="outerHTML" hx-sync="this:replace" hx-confirm="Block {{ .Winner.DisplayName }} from your raffles?">
                            <input type="hidden" name="past_winners" value="{{ if .PastWinnersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="blocked_members" value="{{ if .BlockedMembersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="confirmed" value="{{ if .ConfirmedOpen }}true{{ else }}false{{ end }}">
                            <button type="submit" class="button checklist-block" aria-label="Block {{ .Winner.DisplayName }}" title="Block from raffles">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </form>
                    {{ end }}
                    {{ if and (not .Winner.Confirmed) (not .Winner.Previous) }}
                        <form action="{{ .Winner.ConfirmURL }}" method="POST" hx-post="{{ .Winner.ConfirmURL }}" hx-target="#raffle-live" hx-swap="outerHTML" hx-sync="this:replace">
                            <input type="hidden" name="past_winners" value="{{ if .PastWinnersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="blocked_members" value="{{ if .BlockedMembersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="confirmed" value="{{ if .ConfirmedOpen }}true{{ else }}false{{ end }}">
                            <button type="submit" class="button checklist-check" aria-label="Confirm {{ .Winner.DisplayName }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </button>
                        </form>
                    {{ else if .Winner.Confirmed }}
                        <form action="{{ .Winner.UnconfirmURL }}" method="POST" hx-post="{{ .Winner.UnconfirmURL }}" hx-target="#raffle-live" hx-swap="outerHTML" hx-sync="this:replace">
                            <input type="hidden" name="past_winners" value="{{ if .PastWinnersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="blocked_members" value="{{ if .BlockedMembersOpen }}true{{ else }}false{{ end }}">
                            <input type="hidden" name="confirmed" value="{{ if .ConfirmedOpen }}true{{ else }}false{{ end }}">
                            <button type="submit" class="button checklist-unmark" aria-label="Unmark {{ .Winner.DisplayName }}" title="Unmark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </form>
                    {{ end }}
                </span>
            {{ end }}
        </div>
    </li>
{{ end }}

{{ define "raffle_notice_body" }}
    {{ if .HasNotice }}
        <p class="error">{{ if .Notice.Gone }}{{ .Notice.Person }} is no longer a current winner.{{ else }}{{ .Notice.Person }} is already confirmed{{ if .Notice.Marker }} by {{ .Notice.Marker }}{{ end }}{{ if .Notice.HasAt }} {{ localTime .Notice.At "relative" }}{{ end }}.{{ end }}</p>
    {{ end }}
{{ end }}

{{ define "raffle_live" }}
    <div id="raffle-live" hx-get="{{ .PollURL }}" hx-trigger="every 5s" hx-swap="outerHTML" hx-sync="this:drop" hx-include="#raffle-rerun-form">
        <div class="section">
            {{ if .Winners }}
                <ul class="winners checklist-people">
                    {{ range $winner := .Winners }}
                        {{ template "raffle_winner" (dict "Winner" $winner "PastWinnersOpen" $.PastWinnersOpen "BlockedMembersOpen" $.BlockedMembersOpen "ConfirmedOpen" $.ConfirmedOpen "CanBlock" $.CanBlock "BlockAction" $.BlockAction "BlockedMemberID" $.BlockedMemberID) }}
                    {{ end }}
                </ul>
            {{ else if not .PastWinners }}
                <p class="error">
                    No eligible winners found. Try again later.
                </p>
            {{ end }}
            {{ if .PastWinners }}
                <details id="past-winners" class="collapse" {{ if or .ConfirmedOpen .PastWinnersOpen }}open{{ end }}>
                    <summary>Winners</summary>
                    <ul class="winners checklist-people">
                        {{ range $winner := .PastWinners }}
                            {{ template "raffle_winner" (dict "Winner" $winner "PastWinnersOpen" $.PastWinnersOpen "BlockedMembersOpen" $.BlockedMembersOpen "ConfirmedOpen" $.ConfirmedOpen "CanBlock" $.CanBlock "BlockAction" $.BlockAction "BlockedMemberID" $.BlockedMemberID) }}
                        {{ end }}
                    </ul>
                </details>
            {{ end }}
        </div>

        {{ if .BlockedMembers }}
            <div class="section">
                <details id="blocked-members" class="collapse" {{ if .BlockedMembersOpen }}open{{ end }}>
                    <summary>Blocked Members</summary>
                    <ul class="winners checklist-people">
                        {{ range $member := .BlockedMembers }}
                            <li title="{{ $member.Username }}">
                                <div>
                                    <span class="checklist-person">
                                        {{ if $member.AvatarURL }}
                                            <img src="{{ $member.AvatarURL }}" class="icon-32" alt="">
                                        {{ else }}
                                            <img src="/static/default_avatar.png" class="icon-32" alt="">
                                        {{ end }}
                                        <span class="checklist-person-name">
                                            <span>{{ $member.DisplayName }}</span>
                                            {{ if $member.Username }}
                                                <span class="small-text">{{ $member.Username }}</span>
                                            {{ end }}
                                        </span>
                                    </span>
                                    {{ if $.CanBlock }}
                                        <span class="checklist-actions">
                                            <form action="{{ $.UnblockAction }}{{ $member.ID }}" method="POST" hx-post="{{ $.UnblockAction }}{{ $member.ID }}" hx-target="#raffle-live" hx-swap="outerHTML" hx-sync="this:replace">
                                                <input type="hidden" name="past_winners" value="{{ if $.PastWinnersOpen }}true{{ else }}false{{ end }}">
                                                <input type="hidden" name="blocked_members" value="true">
                                                <input type="hidden" name="confirmed" value="{{ if $.ConfirmedOpen }}true{{ else }}false{{ end }}">
                                                <button type="submit" class="button checklist-block" aria-label="Unblock {{ $member.DisplayName }}" title="Unblock">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                </button>
                                            </form>
                                        </span>
                                    {{ end }}
                                </div>
                            </li>
                        {{ end }}
                    </ul>
                </details>
            </div>
        {{ end }}
    </div>
    {{ if .SwapNotice }}
        <div id="raffle-notice" hx-swap-oob="true">
            {{ template "raffle_notice_body" . }}
        </div>
    {{ end }}
{{ end }}

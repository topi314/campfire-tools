{{ template "head" "Campfire Club Checklist" }}
<div class="container container-wide">
    <div class="container-header">
        {{ template "back_button" .URL }}
        <h1>
            {{ if .AvatarURL }}
                <img src="{{ .AvatarURL }}" alt="">
            {{ end }}
            {{ .Name }}
            {{ template "community_ambassador_flag" .CreatedByCommunityAmbassador }}
        </h1>
    </div>

    {{ template "club_nav" dict "URL" .URL "Active" "checklist" }}

    <div class="section">
        {{ template "events_filter" . }}

        <br/>

        <form action="/tracker/club/{{ .ID }}/checklist" method="POST" id="checklist-form">
            <label class="form-control" for="title">
                Title
                <input class="form-control" type="text" id="title" name="title" maxlength="200" required placeholder="Sticker drop">
            </label>
            <label class="form-control" for="ids" title="Select events for the checklist. You can select multiple events.">
                <div class="section-header">
                    Events({{ len .Events }})
                    <button id="select-all" class="button" type="button">Select All</button>
                </div>
                <select class="form-control" id="ids" name="ids" size="10" multiple>
                    {{ range $event := .Events }}
                        <option value="{{ $event.ID }}">
                            {{ $event.Name }} ({{ $event.CheckIns }})
                        </option>
                    {{ end }}
                </select>
                {{ if .Error }}
                    <p class="error" id="error-message">{{ .Error }}</p>
                {{ end }}
            </label>
            <label class="form-control" for="only-checked-in" title="Only include members who have checked in to the event">
                Only Checked-in Members
                <input class="form-control" type="checkbox" id="only-checked-in" name="only_checked_in" checked>
            </label>
            <button class="form-control" type="submit">Create</button>
        </form>
    </div>
</div>
<script>
    const selectAll = document.getElementById("select-all");
    if (selectAll) {
        selectAll.addEventListener("click", (e) => {
            e.preventDefault();
            const select = document.getElementById("ids");
            for (let i = 0; i < select.options.length; i++) {
                select.options[i].selected = true;
            }
        });
    }
</script>
{{ template "tracker_footer" }}

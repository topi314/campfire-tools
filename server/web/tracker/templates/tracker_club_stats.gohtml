{{ template "head" addStr "Tracker - " .Name " - Statistics" }}
<div class="container">
    <div class="container-header">
        {{ template "back_button" .URL }}
        <h1>
            <img src="{{ .AvatarURL }}">
            {{ .Name }} Statistics
        </h1>
    </div>

    <div class="section">
        {{ template "events_filter" . }}

        <input form="events-filter" id="field-event-categories-closed" type="hidden" name="event-categories-closed" value="{{ if .EventCategories.Open }}false{{ else }}true{{ end }}">
        <input form="events-filter" id="field-league-goals-closed" type="hidden" name="league-goals-closed" value="{{ if .LeagueGoals.Open }}false{{ else }}true{{ end }}">
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Event Categories</h2>
            <div class="inline-form-control">
                <label for="category-sort">
                    <select id="category-sort" name="category-sort" form="events-filter"
                            onchange="document.getElementById('events-filter').requestSubmit()">
                        <option value="check-ins" {{ if eq .CategorySort "check-ins" }}selected{{ end }}>Check-Ins (high → low)</option>
                        <option value="check-ins-asc" {{ if eq .CategorySort "check-ins-asc" }}selected{{ end }}>Check-Ins (low → high)</option>
                        <option value="events" {{ if eq .CategorySort "events" }}selected{{ end }}>Events (high → low)</option>
                        <option value="events-asc" {{ if eq .CategorySort "events-asc" }}selected{{ end }}>Events (low → high)</option>
                        <option value="name" {{ if eq .CategorySort "name" }}selected{{ end }}>Name (A → Z)</option>
                        <option value="name-desc" {{ if eq .CategorySort "name-desc" }}selected{{ end }}>Name (Z → A)</option>
                    </select>
                </label>
            </div>
        </div>

        <details id="event-categories-closed" {{ if .EventCategories.Open }}open{{ end }}>
            <summary>
                View event categories with their accepted and check-in counts.
            </summary>

            <div class="table-7">
                <span>Position</span>
                <span>Category</span>
                <span>Events</span>
                <span>Accepted</span>
                <span>Check-Ins</span>
                <span>Rate</span>
                <span>Total Rate</span>
                {{ range $index, $category := .EventCategories.Categories }}
                    <span>{{ add $index 1 }}</span>
                    <span>
                        {{ if eq $category.Name "Total" }}
                            {{ $category.Name }}
                        {{ else }}
                            <a href="{{ $.URL }}/events?event-category={{ urlquery $category.Name }}{{ if not $.From.IsZero }}&from={{ formatDate $.From }}{{ end }}{{ if not $.To.IsZero }}&to={{ formatDate $.To }}{{ end }}{{ if $.OnlyCAEvents }}&only-ca-events=true{{ end }}{{ if $.SelectedEventCreator }}&event-creator={{ urlquery $.SelectedEventCreator }}{{ end }}" hx-boost="true">{{ formatEventCategory $category.Name }}</a>
                        {{ end }}
                    </span>
                    <span>{{ $category.Events }}</span>
                    <span>{{ $category.Accepted }}</span>
                    <span>{{ $category.CheckIns }}</span>
                    <span>{{ $category.CheckInRate }}%</span>
                    <span>{{ $category.TotalCheckInRate }}%</span>
                {{ else }}
                    <span>No events found.</span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                {{ end }}
            </div>
        </details>
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Digital Codes</h2>
        </div>

        <details id="digital-codes-closed" {{ if .DigitalCodes.Open }}open{{ end }}>
            <summary>
                View digital code count & predictions.
                The amount of digital codes received are roughly 25% of the previous months check-ins.
                (Before February 2026 it was roughly 25% of the previous 3 months).
                Friendship Friday events are excluded by Niantic.
            </summary>

            <div class="table-5">
                <span>Date</span>
                <span>Check-Ins</span>
                <span>Predicted Check-Ins</span>
                <span>Codes</span>
                <span>Predicted Codes</span>

                {{ range $month := .DigitalCodes.Months }}
                    <span>{{ formatMonthNice $month.Date }}</span>
                    <span>{{ $month.CheckIns }}</span>
                    <span>{{ $month.PredictedCheckIns }}</span>
                    <span>{{ $month.Codes }}</span>
                    <span>{{ $month.PredictedCodes }}</span>
                {{ else }}
                    <span>No data found.</span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                {{ end }}
            </div>
        </details>

    </div>

    <div class="section">
        <div class="section-header">
            <h2>Old League Goals</h2>
        </div>

        <details id="league-goals-closed" {{ if .LeagueGoals.Open }}open{{ end }}>
            <summary>
                View league goals and their completion status.
            </summary>

            {{ if .LeagueGoals.BiggestEvent }}
                <p>
                    Your biggest event was <a href="{{ .LeagueGoals.BiggestEvent.URL }}" hx-boost="true"><strong>{{ .LeagueGoals.BiggestEvent.Name }}</strong></a> with
                    <strong>{{ .LeagueGoals.BiggestEvent.CheckIns }}</strong> check-ins.
                </p>

                {{ if lt .LeagueGoals.BiggestEvent.CheckIns 20 }}
                    <p class="error">
                        This event does not meet the minimum requirement of <strong>20</strong> check-ins for Great League and above.
                    </p>
                {{ end }}
            {{ end }}

            <div class="inline-form-control">
                <label for="league-goal-quarter">
                    <select id="league-goal-quarter">
                        {{ range $quarter := .Quarters }}
                            <option value="{{ $quarter.Value }}" {{ if eq $quarter.Value $.LeagueGoals.Quarter }}selected{{ end }}>
                                {{ $quarter.Name }}
                            </option>
                        {{ end }}
                    </select>
                </label>
            </div>

            <div class="table-2">
                <span>Days</span>
                <span>{{ .LeagueGoals.Days }}</span>

                <span>Days Elapsed</span>
                <span>{{ .LeagueGoals.DaysElapsed }}</span>

                <span>Days Remaining</span>
                <span>{{ .LeagueGoals.DaysRemaining }}</span>

                <span>Progress</span>
                {{ template "league_progress" .LeagueGoals.DaysElapsedPercent }}
            </div>

            <div id="league-goals" class="table-4">
                <span>League</span>
                <span>Goal</span>
                <span>Progress</span>
                <span>Projection</span>
                {{ range $league := .LeagueGoals.Goals }}
                    <span>{{ $league.Name }}</span>
                    <span>{{ $league.Goal }}</span>
                    {{ template "league_progress" $league.Progress }}
                    <span>{{ template "checkbox" $league.Projection }}</span>
                {{ end }}
                <span></span>
                <span></span>
                <span>{{ .LeagueGoals.TotalCheckIns }}</span>
                <span>{{ .LeagueGoals.ProjectedCheckIns }}</span>
            </div>
        </details>
    </div>
</div>
<script>
    document.getElementById("event-categories-closed").addEventListener("toggle", (event) => {
        toggleParam(event.target, "event-categories-closed");
    });

    document.getElementById("digital-codes-closed").addEventListener("toggle", (event) => {
        toggleParam(event.target, "digital-codes-closed");
    })

    document.getElementById("league-goals-closed").addEventListener("toggle", (event) => {
        // Default is collapsed; persist open as league-goals-closed=false.
        const url = new URL(window.location);
        if (event.target.open) {
            url.searchParams.set("league-goals-closed", "false");
        } else {
            url.searchParams.delete("league-goals-closed");
        }

        const field = document.getElementById("field-league-goals-closed");
        if (field) {
            field.value = event.target.open ? "false" : "true";
        }

        window.history.replaceState(null, "", url.toString());
    })

    document.getElementById("league-goal-quarter").addEventListener("change", (event) => {
        updateParam(event.target, "league-goal-quarter");
    })

    function updateParam(select, name) {
        const url = new URL(window.location);
        url.searchParams.set(name, select.value);
        window.location = url.toString();
    }

    function toggleParam(element, name) {
        const url = new URL(window.location);
        if (element.open) {
            url.searchParams.delete(name);
        } else {
            url.searchParams.set(name, "true");
        }

        const field = document.getElementById("field-" + name);
        if (field) {
            field.value = element.open ? "false" : "true";
        }

        window.history.replaceState(null, "", url.toString());
    }
</script>
{{ template "tracker_footer" }}

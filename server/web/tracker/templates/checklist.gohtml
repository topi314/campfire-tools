{{ template "head" .Title }}
<div class="container container-wide" data-checklist>
    <div class="container-header">
        {{ template "back_button" .BackURL }}
        <h1>{{ .Title }}</h1>
        <div class="buttons header-actions">
            <button type="button" class="button button-primary reload" hx-get="{{ .EntriesURL }}" hx-target="#checklist-entries" hx-swap="outerHTML" hx-include="#checklist-checked-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                    <path d="M21 3v5h-5"></path>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                    <path d="M8 16H3v5"></path>
                </svg>
                Reload
            </button>
            {{ if .CanEdit }}
                <button type="button" class="button" data-copy="{{ .ShareURL }}" title="Copy share link" aria-label="Copy share link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                </button>
                <a href="{{ .ManageEventsURL }}" class="button" title="Edit" aria-label="Edit" hx-boost="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                </a>
            {{ end }}
        </div>
    </div>

    {{ if .Error }}
        <p class="error">{{ .Error }}</p>
    {{ end }}

    <div id="checklist-notice">
        {{ template "checklist_notice_body" . }}
    </div>

    <div class="checklist-tools">
        <input type="hidden" id="checklist-checked-state" name="checked" value="{{ if .CheckedOpen }}true{{ else }}false{{ end }}">
        <label class="checklist-search" for="checklist-search">
            Search
            <input type="search" id="checklist-search" data-checklist-search placeholder="Display name or username" autocomplete="off" spellcheck="false">
        </label>
    </div>

    {{ template "checklist_entries" . }}

    <div class="section details">
        <h2>Details</h2>
        <dl>
            <div>
                <dt>Created</dt>
                <dd>{{ localTime .CreatedAt "relative" }}</dd>
            </div>
            <div>
                <dt>Checked-in only</dt>
                <dd>{{ if .OnlyCheckedIn }}Yes{{ else }}Checked-in and accepted{{ end }}</dd>
            </div>
            {{ if .Users }}
                <div class="details-wide">
                    <dt>Sharing</dt>
                    <dd>
                        <ul>
                            {{ range $user := .Users }}
                                <li>{{ template "discord_user" $user }}</li>
                            {{ end }}
                        </ul>
                    </dd>
                </div>
            {{ end }}
            <div class="details-wide">
                <dt>Events</dt>
                <dd>
                    {{ if .Events }}
                        <ul>
                            {{ range $event := .Events }}
                                <li><a href="{{ $event.URL }}" hx-boost="true">{{ $event.Name }}</a></li>
                            {{ end }}
                        </ul>
                    {{ else }}
                        None
                    {{ end }}
                </dd>
            </div>
        </dl>
    </div>
</div>
<script>
    (function () {
        if (window.__checklistUI) {
            window.__checklistUI.bind();
            return;
        }

        let cache = [];
        let checkedOpen = new URL(window.location).searchParams.get("checked") === "true";

        function setCheckedParam(open) {
            const url = new URL(window.location);
            if (open) {
                url.searchParams.set("checked", "true");
            } else {
                url.searchParams.delete("checked");
            }
            window.history.replaceState(null, "", url.toString());
            const field = document.getElementById("checklist-checked-state");
            if (field) {
                field.value = open ? "true" : "false";
            }
        }

        function root() {
            return document.querySelector("[data-checklist]");
        }

        function scoreField(query, value) {
            if (!query) {
                return 0;
            }
            if (!value) {
                return -1;
            }
            if (value.startsWith(query)) {
                return 3000 - Math.min(value.length, 500);
            }
            const at = value.indexOf(query);
            if (at >= 0) {
                return 2000 - Math.min(at, 500);
            }
            let qi = 0;
            let first = -1;
            let gaps = 0;
            let prev = -1;
            for (let i = 0; i < value.length && qi < query.length; i++) {
                if (value.charCodeAt(i) === query.charCodeAt(qi)) {
                    if (first < 0) {
                        first = i;
                    }
                    if (prev >= 0 && i > prev + 1) {
                        gaps += i - prev - 1;
                    }
                    prev = i;
                    qi++;
                }
            }
            if (qi < query.length) {
                return -1;
            }
            return 1000 - gaps - first;
        }

        function score(query, row) {
            const display = scoreField(query, row.display);
            const username = scoreField(query, row.username);
            return display > username ? display : username;
        }

        function rebuild() {
            cache = [];
            const list = document.getElementById("checklist-entries");
            if (!list) {
                return;
            }
            const rows = list.querySelectorAll("[data-display]");
            for (let i = 0; i < rows.length; i++) {
                const el = rows[i];
                cache.push({
                    el: el,
                    display: el.getAttribute("data-display") || "",
                    username: el.getAttribute("data-username") || "",
                    received: el.getAttribute("data-received") === "1",
                });
            }
        }

        function apply() {
            const page = root();
            if (!page) {
                return;
            }
            const input = page.querySelector("[data-checklist-search]");
            const waiting = document.getElementById("checklist-waiting");
            const done = document.getElementById("checklist-done");
            if (!input || !waiting) {
                return;
            }

            const query = input.value.trim().toLowerCase();
            const groups = [[], []];
            for (let i = 0; i < cache.length; i++) {
                const row = cache[i];
                const rowScore = query ? score(query, row) : 0;
                if (query && rowScore < 0) {
                    row.el.hidden = true;
                    continue;
                }
                row.el.hidden = false;
                groups[row.received ? 1 : 0].push({row: row, score: rowScore, index: i});
            }

            function compare(a, b) {
                if (query && b.score !== a.score) {
                    return b.score - a.score;
                }
                return a.index - b.index;
            }

            groups[0].sort(compare);
            groups[1].sort(compare);
            for (let i = 0; i < groups[0].length; i++) {
                waiting.appendChild(groups[0][i].row.el);
            }
            if (done) {
                for (let i = 0; i < groups[1].length; i++) {
                    done.appendChild(groups[1][i].row.el);
                }
            }

            const details = document.getElementById("checklist-checked");
            if (details) {
                if (query) {
                    details.hidden = groups[1].length === 0;
                    details.open = !details.hidden && (checkedOpen || groups[1].length > 0);
                } else {
                    details.hidden = false;
                }
                if (!details.dataset.bound) {
                    details.dataset.bound = "1";
                    details.addEventListener("toggle", function () {
                        if (input.value.trim()) {
                            return;
                        }
                        checkedOpen = details.open;
                        setCheckedParam(details.open);
                    });
                }
            }

            const empty = document.getElementById("checklist-search-empty");
            if (empty) {
                empty.hidden = !query || groups[0].length + groups[1].length > 0;
            }
        }

        function bind() {
            const page = root();
            if (!page || page.dataset.bound) {
                return;
            }
            page.dataset.bound = "1";
            const input = page.querySelector("[data-checklist-search]");
            if (input) {
                input.addEventListener("input", apply);
            }
            rebuild();
            apply();
        }

        document.addEventListener("htmx:beforeSwap", function (event) {
            const target = event.detail && event.detail.target;
            if (!target || target.id !== "checklist-entries" || !event.detail.serverResponse) {
                return;
            }
            const details = document.getElementById("checklist-checked");
            const open = !!(details && !details.hidden && details.open);
            checkedOpen = open;
            if (!open || event.detail.serverResponse.indexOf('id="checklist-checked" open') !== -1) {
                return;
            }
            event.detail.serverResponse = event.detail.serverResponse.replace(
                'id="checklist-checked"',
                'id="checklist-checked" open'
            );
        });

        document.addEventListener("htmx:afterSwap", function () {
            if (!root()) {
                return;
            }
            rebuild();
            apply();
        });

        window.__checklistUI = {bind: bind};
        bind();
    })();
</script>
{{ template "tracker_footer" }}

{{ define "checklist_notice_body" }}
    {{ if .HasNotice }}
        <p class="error">{{ .Notice.Person }} is already marked{{ if .Notice.Marker }} by {{ .Notice.Marker }}{{ end }}{{ if .Notice.HasAt }} {{ localTime .Notice.At "relative" }}{{ end }}.</p>
    {{ end }}
{{ end }}

{{ define "checklist_person" }}
    <li data-display="{{ .Person.SearchDisplay }}" data-username="{{ .Person.SearchUsername }}" data-received="{{ if .Person.Received }}1{{ else }}0{{ end }}">
        <div>
            <span class="checklist-person">
                {{ if .Person.Member.AvatarURL }}
                    <img src="{{ .Person.Member.AvatarURL }}" class="icon-32" alt="">
                {{ else }}
                    <img src="/static/default_avatar.png" class="icon-32" alt="">
                {{ end }}
                <span class="checklist-person-name">
                    <span>{{ .Person.Member.DisplayName }}{{ if .Person.CheckIns }} ({{ .Person.CheckIns }}){{ end }}</span>
                    {{ if .Person.Member.Username }}
                        <span class="small-text">{{ .Person.Member.Username }}</span>
                    {{ end }}
                </span>
            </span>
            {{ if .CanEdit }}
                <span class="checklist-actions">
                    <form action="{{ .ActionBase }}/toggle/{{ .Person.Member.ID }}" method="POST" hx-post="{{ .ActionBase }}/toggle/{{ .Person.Member.ID }}" hx-target="#checklist-entries" hx-swap="outerHTML" hx-include="#checklist-checked-state">
                        {{ if .Person.Received }}
                            <input type="hidden" name="received" value="false">
                            <button type="submit" class="button checklist-unmark" aria-label="Unmark {{ .Person.Member.DisplayName }}" title="Unmark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        {{ else }}
                            <input type="hidden" name="received" value="true">
                            <button type="submit" class="button checklist-check" aria-label="Check {{ .Person.Member.DisplayName }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </button>
                        {{ end }}
                    </form>
                </span>
            {{ end }}
        </div>
    </li>
{{ end }}

{{ define "checklist_entries" }}
    <div id="checklist-entries" hx-get="{{ .EntriesURL }}" hx-trigger="every 5s" hx-swap="outerHTML" hx-sync="this:drop" hx-include="#checklist-checked-state">
        <p class="checklist-count">{{ .Received }} / {{ .Total }} received</p>
        {{ if not .People }}
            <p>No one on this checklist yet.</p>
        {{ else }}
            <p id="checklist-search-empty" hidden>No matching people.</p>
            {{ if eq .Received .Total }}
                <p>No one left.</p>
            {{ end }}
            <ul id="checklist-waiting" class="winners checklist-people">
                {{ range $person := .People }}
                    {{ if not $person.Received }}
                        {{ template "checklist_person" (dict "Person" $person "CanEdit" $.CanEdit "ActionBase" $.ActionBase) }}
                    {{ end }}
                {{ end }}
            </ul>
            {{ if .Received }}
                <details id="checklist-checked" class="collapse" {{ if .CheckedOpen }}open{{ end }}>
                    <summary>Received ({{ .Received }})</summary>
                    <ul id="checklist-done" class="winners checklist-people">
                        {{ range $person := .People }}
                            {{ if $person.Received }}
                                {{ template "checklist_person" (dict "Person" $person "CanEdit" $.CanEdit "ActionBase" $.ActionBase) }}
                            {{ end }}
                        {{ end }}
                    </ul>
                </details>
            {{ end }}
        {{ end }}
    </div>
    {{ if .SwapNotice }}
        <div id="checklist-notice" hx-swap-oob="true">
            {{ template "checklist_notice_body" . }}
        </div>
    {{ end }}
{{ end }}

{{ define "checklist_add_results" }}
    <div id="checklist-add-results">
        {{ if eq .Query "" }}
            <p>Search for a member to add them.</p>
        {{ else if lt (len .Query) 2 }}
            <p>Enter at least 2 characters to search.</p>
        {{ else if not .Members }}
            <p>No members found for "{{ .Query }}".</p>
        {{ else }}
            <div class="table-4">
                <span></span>
                <span>Username</span>
                <span>Display Name</span>
                <span></span>
                {{ range $member := .Members }}
                    <span>
                        {{ if $member.AvatarURL }}
                            <img src="{{ $member.AvatarURL }}" class="icon-32" alt="">
                        {{ else }}
                            <img src="/static/default_avatar.png" class="icon-32" alt="">
                        {{ end }}
                    </span>
                    <span>{{ $member.Username }}</span>
                    <span>{{ $member.DisplayName }}</span>
                    <span>
                        {{ if index $.OnList $member.ID }}
                            <span class="small-text">On the list</span>
                        {{ else }}
                            <form action="{{ $.ActionBase }}/members" method="POST">
                                <input type="hidden" name="member_id" value="{{ $member.ID }}">
                                <button type="submit" class="button small success">Add</button>
                            </form>
                        {{ end }}
                    </span>
                {{ end }}
            </div>
        {{ end }}
    </div>
{{ end }}

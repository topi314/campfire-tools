{{ template "head" "Raffle Blocked Members" }}
<div class="container container-wide">
    <div class="container-header">
        {{ template "back_button" "/raffle" }}
        <h1>Blocked Members</h1>
    </div>

    <p>Members on this list are excluded from all of your raffles.</p>

    {{ if .Error }}
        <p class="error">{{ .Error }}</p>
    {{ end }}
    {{ if .Success }}
        <p class="success-message">{{ .Success }}</p>
    {{ end }}

    <div class="section">
        <div class="section-header">
            <h2>Blocked ({{ len .BlockedMembers }})</h2>
        </div>
        {{ if not .BlockedMembers }}
            <p>No blocked members yet.</p>
        {{ else }}
            <div class="table-4">
                <span></span>
                <span>Username</span>
                <span>Display Name</span>
                <span></span>
                {{ range $member := .BlockedMembers }}
                    <span>
                        {{ if $member.AvatarURL }}
                            <img src="{{ $member.AvatarURL }}" class="icon-32" alt="">
                        {{ else }}
                            <img src="/static/default_avatar.png" class="icon-32" alt="">
                        {{ end }}
                    </span>
                    <span>
                        <a href="{{ $member.URL }}" hx-boost="true">{{ $member.Username }}</a>
                        {{ template "community_ambassador_flag" $member.IsCommunityAmbassador }}
                    </span>
                    <span><a href="{{ $member.URL }}" hx-boost="true">{{ $member.DisplayName }}</a></span>
                    <span>
                        <form action="/raffle/blocked/remove" method="POST">
                            <input type="hidden" name="member_id" value="{{ $member.ID }}">
                            <button type="submit" class="button danger">Remove</button>
                        </form>
                    </span>
                {{ end }}
            </div>
        {{ end }}
    </div>

    <div id="search" class="section">
        <div class="section-header">
            <h2>Add Member</h2>
            <form class="inline-form-control" hx-get="/raffle/blocked" hx-target="#search-results" hx-swap="outerHTML" hx-select="#search-results" hx-push-url="true" hx-trigger="submit, input changed delay:400ms from:input">
                <label for="q">
                    <input type="search" id="q" name="q" value="{{ .Query }}" placeholder="Username, display name, or member ID" autofocus minlength="2">
                </label>
            </form>
        </div>

        <div id="search-results">
            {{ if eq .Query "" }}
                <p>Search for a member to block them from your raffles.</p>
            {{ else if lt (len .Query) 2 }}
                <p>Enter at least 2 characters to search.</p>
            {{ else if not .SearchMembers }}
                <p>No members found for "{{ .Query }}".</p>
            {{ else }}
                <p>{{ len .SearchMembers }} result{{ if ne (len .SearchMembers) 1 }}s{{ end }}{{ if eq (len .SearchMembers) 100 }} (limited to 100){{ end }}</p>
                <div class="table-4">
                    <span></span>
                    <span>Username</span>
                    <span>Display Name</span>
                    <span></span>
                    {{ range $member := .SearchMembers }}
                        <span>
                            {{ if $member.AvatarURL }}
                                <img src="{{ $member.AvatarURL }}" class="icon-32" alt="">
                            {{ else }}
                                <img src="/static/default_avatar.png" class="icon-32" alt="">
                            {{ end }}
                        </span>
                        <span>
                            <a href="{{ $member.URL }}" hx-boost="true">{{ $member.Username }}</a>
                            {{ template "community_ambassador_flag" $member.IsCommunityAmbassador }}
                        </span>
                        <span><a href="{{ $member.URL }}" hx-boost="true">{{ $member.DisplayName }}</a></span>
                        <span>
                            {{ if index $.BlockedMemberID $member.ID }}
                                <span class="small-text">Blocked</span>
                            {{ else }}
                                <form action="/raffle/blocked" method="POST">
                                    <input type="hidden" name="member_id" value="{{ $member.ID }}">
                                    <button type="submit" class="button">Block</button>
                                </form>
                            {{ end }}
                        </span>
                    {{ end }}
                </div>
            {{ end }}
        </div>
    </div>
</div>
{{ template "tracker_footer" }}

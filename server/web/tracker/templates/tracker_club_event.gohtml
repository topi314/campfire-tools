{{ template "head" addStr "Tracker - " .Name }}
<div class="container container-wide">
    <div class="container-header">
        {{ template "back_button" .Club.URL }}
        <h1>
            {{ template "event_cover" . }}
            {{ .Name }}
            {{ template "community_ambassador_flag" .CreatedByCommunityAmbassador }}
        </h1>
    </div>

    <div class="buttons" hx-boost="true">
        <a href="{{ .Club.URL }}/export?event={{ .ID }}" class="button">Export</a>
        <a href="{{ .Club.URL }}/raffle?event={{ .ID }}" class="button">Raffle</a>
        {{ if not .Finished }}
            <a href="/tracker/event/{{ .ID }}/refresh" class="button">Refresh</a>
        {{ end }}
        <button class="button button-icon" type="button"
                title="Copy Share Link"
                aria-label="Copy Share Link"
                hx-post="/tracker/event/{{ .ID }}/share-link"
                hx-target="#share-link-dialog-body"
                hx-swap="innerHTML"
                hx-boost="false"
                hx-on::after-request="if (event.detail.xhr) document.getElementById('share-link-dialog').showModal()">
            <img src="/static/link.svg" alt="">
        </button>
    </div>

    <div class="section event-summary">
        <div class="event-stats">
            <div class="event-stat">
                <span class="event-stat-value">{{ .TotalCheckIns }}</span>
                <span class="event-stat-label">Check-Ins</span>
            </div>
            <div class="event-stat">
                <span class="event-stat-value">{{ .TotalAccepted }}</span>
                <span class="event-stat-label">Accepted</span>
            </div>
            <div class="event-stat">
                <span class="event-stat-value">{{ .TotalCheckInRate }}%</span>
                <span class="event-stat-label">Check-In Rate</span>
            </div>
            {{ if gt .DiscordInterested 0 }}
                <div class="event-stat">
                    <span class="event-stat-value">{{ .DiscordInterested }}</span>
                    <span class="event-stat-label">Discord Interested</span>
                </div>
            {{ end }}
        </div>
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Overview</h2>
        </div>

        <div class="event-overview">
            <div class="event-overview-item">
                <strong>Club</strong>
                <div>
                    {{ if .Club.AvatarURL }}
                        <img class="icon-32" src="{{ .Club.AvatarURL }}" alt="">
                    {{ else }}
                        <img class="icon-32" src="/static/default_avatar.png" alt="">
                    {{ end }}
                    <a href="{{ .Club.URL }}" title="{{ .Club.ID }}" hx-boost="true">{{ .Club.Name }}</a>
                </div>
            </div>

            <div class="event-overview-item">
                <strong>Creator</strong>
                <div>{{ template "campfire_member_inline" .Creator }}</div>
            </div>

            <div class="event-overview-item">
                <strong>Start</strong>
                <div>{{ formatTimeToRelDayTime .Time }}</div>
            </div>

            <div class="event-overview-item">
                <strong>End</strong>
                <div>{{ formatTimeToRelDayTime .EndTime }}</div>
            </div>

            <div class="event-overview-item">
                <strong>Status</strong>
                <div>{{ if .Finished }}Finished{{ else }}Upcoming / Active{{ end }}</div>
            </div>

            {{ if .Address }}
                <div class="event-overview-item">
                    <strong>Address</strong>
                    <div class="event-description">
                        {{ if .MapURL }}
                            <a href="{{ .MapURL }}" target="_blank" rel="noopener noreferrer">{{ .Address }}</a>
                        {{ else }}
                            {{ .Address }}
                        {{ end }}
                    </div>
                </div>
            {{ end }}

            {{ if .CampfireLiveEventName }}
                <div class="event-overview-item">
                    <strong>Campfire Live Event</strong>
                    <div title="{{ .CampfireLiveEventID }}">{{ .CampfireLiveEventName }}</div>
                </div>
            {{ end }}

            <div class="event-overview-item">
                <strong>Imported</strong>
                <div>{{ formatTimeToRelDayTime .ImportedAt }}</div>
            </div>
        </div>

        <form class="stacked-form-control event-category-form" method="post" action="/tracker/event/{{ .ID }}/category" hx-boost="false"
              onsubmit="return ensureCategorySelected(event)">
            <label class="form-control" for="event-category">
                <strong>Category</strong>
                <select id="event-category" name="event-category" required
                        onchange="onCategoryChange(this)">
                    {{ range $category := .ClubCategories }}
                        <option value="{{ $category }}" {{ if eq $.Category $category }}selected{{ end }}>{{ formatEventCategory $category }}</option>
                    {{ end }}
                    <option value="__custom__">Custom…</option>
                </select>
            </label>
            <button type="submit">Save Category</button>
        </form>
    </div>

    {{ if .Details }}
        <div class="section">
            <div class="section-header">
                <h2>Description</h2>
            </div>
            <p class="event-description">{{ .Details }}</p>
        </div>
    {{ end }}

    <div class="section">
        <div class="section-header">
            <h2>Check-Ins ({{ len .CheckedInMembers }})</h2>
        </div>
        <ul class="list">
            {{ range $member := .CheckedInMembers }}
                {{ template "campfire_member_list_item" $member }}
            {{ else }}
                <span>No members have checked in.</span>
            {{ end }}
        </ul>
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Accepted, Not Checked In ({{ len .AcceptedMembers }})</h2>
        </div>
        <ul class="list">
            {{ range $member := .AcceptedMembers }}
                {{ template "campfire_member_list_item" $member }}
            {{ else }}
                <span>No members have accepted and not checked in.</span>
            {{ end }}
        </ul>
    </div>
</div>

<dialog id="share-link-dialog" class="dialog">
    <div id="share-link-dialog-body"></div>
    <div class="buttons">
        <button type="button" class="button" onclick="document.getElementById('share-link-dialog').close()">Close</button>
    </div>
</dialog>

<dialog id="custom-category-dialog" class="dialog">
    <form class="stacked-form-control" method="dialog" onsubmit="return confirmCustomCategory(event)">
        <h3>Custom category</h3>
        <label class="form-control" for="custom-category-input">
            Name
            <input type="text" id="custom-category-input" placeholder="Enter a category name" required autocomplete="off">
        </label>
        <div class="buttons">
            <button type="button" class="button" onclick="cancelCustomCategory()">Cancel</button>
            <button type="submit" class="button">Use category</button>
        </div>
    </form>
</dialog>

<script>
    const categorySelect = document.getElementById('event-category');
    const customDialog = document.getElementById('custom-category-dialog');
    const customInput = document.getElementById('custom-category-input');
    let previousCategory = categorySelect.value === '__custom__'
        ? (categorySelect.options[0] && categorySelect.options[0].value !== '__custom__' ? categorySelect.options[0].value : '')
        : categorySelect.value;

    function onCategoryChange(select) {
        if (select.value === '__custom__') {
            customInput.value = '';
            customDialog.showModal();
            customInput.focus();
            return;
        }
        previousCategory = select.value;
    }

    function cancelCustomCategory() {
        categorySelect.value = previousCategory;
        customDialog.close();
        customInput.value = '';
    }

    function confirmCustomCategory(event) {
        event.preventDefault();
        const name = customInput.value.trim();
        if (!name) {
            return false;
        }

        let option = Array.from(categorySelect.options).find((opt) => opt.value === name);
        if (!option) {
            option = new Option(name + ' (Custom)', name, true, true);
            const customOption = categorySelect.querySelector('option[value="__custom__"]');
            categorySelect.insertBefore(option, customOption);
        } else {
            option.selected = true;
        }

        previousCategory = name;
        customDialog.close();
        customInput.value = '';
        return false;
    }

    function ensureCategorySelected(event) {
        if (categorySelect.value === '__custom__' || categorySelect.value === '') {
            event.preventDefault();
            onCategoryChange(categorySelect);
            return false;
        }
        return true;
    }

    customDialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        cancelCustomCategory();
    });

    {{ if .IsCustomCategory }}
    categorySelect.value = '__custom__';
    {{ end }}
</script>
{{ template "tracker_footer" }}
